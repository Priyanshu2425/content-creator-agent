    {"type":"text","id":"ev_manifest_txt","x":112,"y":800,"width":276,"height":178,"text":"MediaManifest (pipeline input)\n───────────────────────────\nvoiceover: str  # asset_id\nassets: tuple[AssetFact, ...]\n  .id  .type  .src\n  .duration  .width  .height\n  .description  .usage_advice\nduration: float  # seconds\nfps: float\ntranscript: Transcript","originalText":"MediaManifest (pipeline input)\n───────────────────────────\nvoiceover: str  # asset_id\nassets: tuple[AssetFact, ...]\n  .id  .type  .src\n  .duration  .width  .height\n  .description  .usage_advice\nduration: float  # seconds\nfps: float\ntranscript: Transcript","fontSize":11,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#22c55e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":201055,"version":1,"versionNonce":201056,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},

